# =======================================
# Header file
# =======================================
material:num-materials = 3

# =======================================
# Material 1: Fe Sublattice A (Spin Up)
# =======================================
material[1]:material-name = Fe_A
material[1]:material-element = Fe
material[1]:unit-cell-category = 1

material[1]:damping-constant = 1
material[1]:atomic-spin-moment = 3.15 !muB
material[1]:uniaxial-anisotropy-constant = 1.404e-23
material[1]:initial-spin-direction = 0,0,1
material[1]:mass = 5.7915e-3
material[1]:damping-constant-lattice = 0.6
material[1]:exchange-J0 = 1 !eV
material[1]:harmonic-potential-V0 = 0.15 !eV
material[1]:coupling-C0 = 0.5
# material[1]:four-spin-constant[1] = -0.23e-21

# =======================================
# Material 2: Fe Sublattice B (Spin Down)
# =======================================
material[2]:material-name = Fe_B
material[2]:material-element = Al
material[2]:unit-cell-category = 2

material[2]:damping-constant = 1
material[2]:atomic-spin-moment = 3.15 !muB
material[2]:uniaxial-anisotropy-constant = 1.404e-23
material[2]:initial-spin-direction = 0,0,-1
material[2]:mass = 5.7915e-3
material[2]:damping-constant-lattice = 0.6
material[2]:exchange-J0 = 1 !eV
material[2]:harmonic-potential-V0 = 0.15 !eV
material[2]:coupling-C0 = 0.5
# material[1]:four-spin-constant[1] = -0.23e-21


# =======================================
# Material 3: Rh Sublattice 
# =======================================
material[3]:material-name = Rh
material[3]:material-element = Rh
material[3]:unit-cell-category = 3

material[3]:damping-constant = 1
material[3]:non-magnetic = keep
material[3]:mass = 5.7915e-3
material[3]:initial-spin-direction = 0,0,1
material[3]:damping-constant-lattice = 0.6
material[3]:exchange-J0 = 0 !eV
material[3]:harmonic-potential-V0 = 0.15 !eV
material[3]:coupling-C0 = 0.5
# material[2]:four-spin-constant[2] = 0
