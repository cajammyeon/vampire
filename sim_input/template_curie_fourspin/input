#------------------------------------------
# Creation attributes
#------------------------------------------
dimensions:unit-cell-size = 3 !A
dimensions:system-size-x = 6 !nm
dimensions:system-size-y = 6 !nm
dimensions:system-size-z = 4 !nm

#------------------------------------------
# Material files
#------------------------------------------
create:crystal-structure = bcc
create:crystal-sublattice-materials = true
create:periodic-boundaries-x = true
create:periodic-boundaries-y = true
create:periodic-boundaries-z = true

material:file = FeRh.mat
material:unit-cell-file = FeRh.ucf

#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program = curie-temperature
sim:integrator = spin-lattice

#------------------------------------------
# Simulation attributes
#------------------------------------------
sim:equilibration-time-steps = 5000
sim:loop-time-steps = 1000
sim:time-steps-increment = 10

sim:minimum-temperature = 0
sim:maximum-temperature = 1500
sim:temperature-increment = 0.1
sim:time-steps-increment = 1

sim:time-step = 1 !fs

#------------------------------------------
# SLD config
#------------------------------------------
spin-lattice:potential-cutoff-range = 8.15 !A
spin-lattice:fields-cutoff-range = 10 !A
spin-lattice:coupling = pseudodipolar
spin-lattice:potential = harmonic

exchange:interaction-range = 3
exchange:four-spin-cutoff-1 = 1.0
exchange:four-spin-cutoff-2 = 1.414

#------------------------------------------
# Data output
#------------------------------------------
config:atoms
config:atoms-output-rate = 10
config:sld

output:real-time

output:temperature
output:lattice-temperature
output:spin-temperature

output:magnetisation
output:material-magnetisation
output:mean-magnetisation-length

output:total-energy
output:mean-specific-heat

output:kinetic-energy
output:potential-energy
output:sld-exchange-energy
output:sld-coupling-energy
output:sld-total-energy