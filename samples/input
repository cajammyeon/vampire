#------------------------------------------
# Creation attributes
#------------------------------------------
dimensions:unit-cell-size = 5 !A
dimensions:system-size-x = 3 !nm
dimensions:system-size-y = 3 !nm
dimensions:system-size-z = 3 !nm

#------------------------------------------
# Material files
#------------------------------------------
create:crystal-structure = bcc
create:crystal-sublattice-materials = true
create:periodic-boundaries-x = true
create:periodic-boundaries-y = true
create:periodic-boundaries-z = true

material:file = FeRh.mat

#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program = field-cool
sim:integrator = spin-lattice

#------------------------------------------
# Simulation attributes
#------------------------------------------
sim:cooling-function = gaussian
sim:cooling-time = 100!ps

sim:maximum-temperature = 300
sim:minimum-temperature = 0

sim:applied-field-strength = 0!T

sim:equilibration-temperature = 300
sim:equilibration-time-steps = 10000

sim:total-time-steps = 1000
sim:time-steps-increment = 100
sim:time-step = 1e-16

#------------------------------------------
# SLD config
#------------------------------------------
spin-lattice:potential-cutoff-range = 4.0 !A
spin-lattice:fields-cutoff-range = 3.75 !A
spin-lattice:coupling = pseudodipolar
spin-lattice:potential = harmonic

exchange:interaction-range = 3

#------------------------------------------
# Data output
#------------------------------------------
config:atoms
config:atoms-output-rate = 10
config:sld

output:real-time
output:temperature
output:magnetisation
output:lattice-temperature
output:spin-temperature
