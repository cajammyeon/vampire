#------------------------------------------
# Creation attributes
#------------------------------------------
dimensions:unit-cell-size = 2.99 !A
dimensions:system-size-x = 4.8 !nm
dimensions:system-size-y = 4.8 !nm
dimensions:system-size-z = 1.5 !nm

#------------------------------------------
# Material files
#------------------------------------------
create:crystal-structure = bcc
create:crystal-sublattice-materials = true

material:file = FeRh.mat

#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program = time-series
sim:integrator = spin-lattice

#------------------------------------------
# Simulation attributes
#------------------------------------------
sim:time-steps-increment = 1
sim:total-time-steps = 20000
sim:time-step = 0.5 !fs
sim:temperature = 300

#------------------------------------------
# SLD config
#------------------------------------------
spin-lattice:potential-cutoff-range = 7.8 !A
spin-lattice:fields-cutoff-range = 3.75 !A
spin-lattice:coupling = pseudodipolar
spin-lattice:potential = harmonic

exchange:interaction-range = 3

#------------------------------------------
# Data output
#------------------------------------------
config:atoms
config:atoms-output-rate = 10000
config:output-format = text
config:sld

output:real-time
output:temperature
output:magnetisation