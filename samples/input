#------------------------------------------
# Creation attributes
#------------------------------------------
dimensions:unit-cell-size = 3 !A
dimensions:system-size-x = 5 !nm
dimensions:system-size-y = 5 !nm
dimensions:system-size-z = 2 !nm

#------------------------------------------
# Material files
#------------------------------------------
create:crystal-structure = bcc
create:crystal-sublattice-materials = true
create:periodic-boundaries-x = true
create:periodic-boundaries-y = true

material:file = FeRh.mat

#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program = field-cool
sim:integrator = spin-lattice

#------------------------------------------
# Simulation attributes
#------------------------------------------
sim:cooling-function = linear
sim:cooling-time = 1

sim:equilibration-time-steps = 10000
sim:loop-time-steps = 10000

sim:maximum-temperature = 1000.0 
sim:minimum-temperature = 0.0
sim:temperature-increment = -10.0

#------------------------------------------
# SLD config
#------------------------------------------
spin-lattice:potential-cutoff-range = 7.8 !A
spin-lattice:fields-cutoff-range = 3.75 !A
spin-lattice:coupling = pseudodipolar
spin-lattice:potential = harmonic

exchange:interaction-range = 3

#------------------------------------------
# Data output
#------------------------------------------
config:atoms
config:atoms-output-rate = 10
config:sld

output:real-time
output:temperature
output:magnetisation
