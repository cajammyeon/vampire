#---------------------------------
# Header of the file
#---------------------------------
material:num-materials = 2

#------------------------------------------------
# Material 1 (Fe)
#------------------------------------------------
material[1]:material-name = Fe
material[1]:material-element = Fe
material[1]:unit-cell-category = 1

material[1]:damping-constant = 0.1
material[1]:atomic-spin-moment = 2.22 !muB
material[1]:uniaxial-anisotropy-constant = 1.0e-24
material[1]:initial-spin-direction = 0,0,1
material[1]:mass = 5.7915e-3
material[1]:damping-constant-lattice = 0.6
material[1]:exchange-J0 = 0.904 !eV
material[1]:harmonic-potential-V0 = 0.15 !eV
material[1]:coupling-C0 = 0.5

#------------------------------------------------
# Material 2 (Rh)
#------------------------------------------------
